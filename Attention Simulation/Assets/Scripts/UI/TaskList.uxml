        <ui:VisualElement name="todo-list" data-source-type="Emyra.FocusGame.UI.SubjectColorDataSource, Assembly-CSharp" style="flex-grow: 0; width: 400px; height: 400px; background-color: rgba(0, 0, 0, 0.11); margin-left: 20px; display: none;">
